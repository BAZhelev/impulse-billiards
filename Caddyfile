# Reverse proxy for the Payload CMS (admin + API).
# Cloudflare terminates public TLS; Caddy serves a self-signed origin cert
# (Cloudflare SSL/TLS mode: "Full"). Swap `tls internal` for a Cloudflare
# Origin Certificate when moving to "Full (strict)".
staging.admin.impulse-billiards.com {
	tls internal
	encode gzip
	reverse_proxy cms:3000
}
