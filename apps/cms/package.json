{
  "name": "cms",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check-types": "tsc --noEmit",
    "db:provision": "bash ./scripts/provision-db.sh",
    "dev": "next dev -p 3001",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "eslint --max-warnings 0 --no-warn-ignored",
    "payload": "payload",
    "predev": "pnpm run db:provision",
    "start": "next start",
    "test": "echo \"No unit tests configured yet\" && exit 0",
    "test:e2e": "pnpm run db:provision && cross-env DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "pnpm run db:provision && cross-env NODE_ENV=development DOTENV_CONFIG_PATH=.env.test vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "@payloadcms/db-postgres": "3.88.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.1",
    "jsdom": "28.0.0",
    "prettier": "^3.9.6",
    "tsx": "4.22.4",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
