{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "PAYLOAD_SECRET",
    "CI",
    "PORT",
    "NODE_ENV",
    "GITHUB_PAT",
    "GITHUB_REPO",
    "GITHUB_WORKFLOW",
    "GITHUB_REF",
    "PAYLOAD_MIGRATION_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "package.json", "pnpm-lock.yaml"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "package.json", "pnpm-lock.yaml"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["$TURBO_DEFAULT$", "package.json", "pnpm-lock.yaml"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "package.json", "pnpm-lock.yaml"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
